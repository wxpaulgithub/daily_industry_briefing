# AI 商机 V2：模型名由环境配置；不填写密钥或模型时自动回退规则。
SITE_URL=https://mag.mhstar.tech
FETCH_NEWS_ON_STARTUP=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_OPPORTUNITY_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
GLM_API_KEY=
GLM_OPPORTUNITY_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# true: discover with Zhipu's web-search-pro, analyze with GLM_OPPORTUNITY_MODEL.
GLM_WEB_SEARCH_ENABLED=false
OPPORTUNITY_FALLBACK_PROVIDER=
OPPORTUNITY_SEARCH_PROVIDER=auto
OPPORTUNITY_ENABLED=true
OPPORTUNITY_AI_ENABLED=true
# 灰度检查 2–4 周后再开启自动推送。
OPPORTUNITY_AUTO_PUBLISH=false
OPPORTUNITY_AI_REASONING=medium
OPPORTUNITY_AI_RESEARCH_LIMIT=12
OPPORTUNITY_CANDIDATE_LIMIT=40
OPPORTUNITY_DISPLAY_LIMIT=10
OPPORTUNITY_DIGEST_LIMIT=5
OPPORTUNITY_AI_CONCURRENCY=2
OPPORTUNITY_TASK_TIMEOUT=1200
OPPORTUNITY_AI_REQUEST_TIMEOUT=180
OPENAI_OPPORTUNITY_MAX_TOOL_CALLS=12
OPPORTUNITY_DISCOVERY_SEARCH_BUDGET=8
OPPORTUNITY_VERIFY_SEARCH_BUDGET=12
OPPORTUNITY_TOTAL_SEARCH_BUDGET=24
OPPORTUNITY_MEMORY_RECHECK_HOURS=24
OPENAI_OPPORTUNITY_MAX_OUTPUT_TOKENS=8000
OPPORTUNITY_MAX_LLM_CALLS=40
WECOM_OPPORTUNITY_WEBHOOK_URL=
OPPORTUNITY_PUBLISH_ATTEMPTS=3
OPPORTUNITY_PUBLISH_RETRY_SECONDS=600
# 可选，按已选供应商当前价格填写；未配置时 estimated_cost 为 null。
OPPORTUNITY_INPUT_COST_PER_MILLION=
OPPORTUNITY_OUTPUT_COST_PER_MILLION=
OPPORTUNITY_SEARCH_COST_PER_THOUSAND=
